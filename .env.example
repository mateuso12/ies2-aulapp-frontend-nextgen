# Firebase Configuration
# Copy this file to .env.local and fill with your Firebase project credentials

# Environment: local | development | homologation | production
VITE_ENVIRONMENT=local

# (Opcional) Porta local do web-components (padrão: 5173). Use 5174 se necessário.
VITE_WEB_COMPONENTS_PORT=5173

# Firebase Config - Local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
